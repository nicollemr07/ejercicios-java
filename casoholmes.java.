import java.util.Scanner;

public class CasoDetective {
    public static void main(String[] args) {
        Scanner teclado = new Scanner(System.in);

        String nombre;
        int edad;
        int pistas = 0;
        int opcion;
        boolean casoResuelto = false;

        //=====BIENVENIDA=====
        System.out.println("==========================\n======");
        System.out.println(" DESPACHO HOLMES &\nASOCIADOS");
        System.out.println(" Caso #1: HIDDEN");
        System.out.println("==========================\n======");

        System.out.print("Detective, ¿cuál es tu\nnombre? ");
        nombre = teclado.nextLine();

       
        System.out.print("¿Cuál es tu edad? ");
        edad = teclado.nextInt();
        teclado.nextLine();

       
        if (edad < 18) {
            System.out.println("Lo siento, tu edad no cumple.");
            return;
        }

        System.out.println("");
        System.out.println("Bienvenido, detective " + nombre + ".");
        System.out.println("Tu misión: resolver el\ncaso HIDDEN.");
        System.out.println("Necesitas al menos 3\npistas.");

        System.out.println("\n--- MENÚ DEL DETECTIVE\n---");
        System.out.println("1. Buscar pistas");
        System.out.println("2. Interrogar\nsospechosos");
        System.out.println("3. Resolver el caso");

        System.out.print("Elige una opción (1-3): ");
        opcion = teclado.nextInt();
        teclado.nextLine();

        switch (opcion) {

            case 1:
                System.out.println("\n BUSCANDO PISTAS...");
                String[] evidencias = {
                        "Huella digital en la ventana",
                        "Copa de vino con residuos",
                        "Nota rasgada en el escritorio",
                        "Cuchillo en la cocina"
                };

                for (int i = 0; i < evidencias.length; i++) {
                    pistas++;
                    System.out.println(" Pista #" + pistas + ": " + evidencias[i]);
                }

                System.out.println("Total de pistas: " + pistas);
                break;

            case 2:
                System.out.println("\nINTERROGATORIOS");

                String[] sospechosos = {
                        "James Barnes", "Aurelio Vásquez",
                        "Victoria Reyes", "Bruno Quiroga"
                };

                int s = 0;
                String seguir = "si";

                while (seguir.equals("si")) {
                    System.out.println(" Interrogando a: " + sospechosos[s]);
                    System.out.println(" -> Dice que es\ninocente...");
                    s++;

                    if (s < sospechosos.length) {
                        System.out.print(" ¿Interrogar al siguiente?\n(si/no): ");
                        seguir = teclado.nextLine();
                    } else {
                        System.out.println(" No hay más\nsospechosos.");
                        seguir = "no";
                    }
                }
                break;

            case 3:
                System.out.println("\n RESOLUCIÓN DEL CASO");

                if (pistas >= 3) {
                    System.out.println(" ¡Tienes suficientes\npistas!");
                    System.out.println(" El culpable es: Aurelio\nVásquez");
                    System.out.println(" ¡CASO RESUELTO, detective " + nombre + "!");
                    casoResuelto = true;

                } else if (pistas >= 1) {
                    System.out.println(" Tienes " + pistas + " pista(s). Necesitas 3.");
                    System.out.println(" ¡Sigue investigando!");

                } else {
                    System.out.println(" No tienes ninguna\npista.");
                    System.out.println(" Ve a buscar pistas\nprimero.");
                }
                break;
        }
    }
}
